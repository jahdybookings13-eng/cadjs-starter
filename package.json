{
  "name": "cadjs-starter",
  "version": "0.1.0",
  "description": "Reference UI / runnable demo built on the cadjs library.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/avr-assets.mjs && node scripts/stm32f4-assets.mjs",
    "dev": "vite",
    "avr:assets": "node scripts/avr-assets.mjs",
    "prebuild": "node scripts/avr-assets.mjs && node scripts/stm32f4-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:vr": "playwright test e2e/vr-bridge.spec.ts",
    "vr:probe": "node scripts/vr-probe.mjs",
    "vr:view": "node scripts/vr-viewer.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:perf": "ECAD_BENCH=1 vitest run src/ecad/__tests__/perf.test.ts --reporter=verbose",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:bible": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@horang-corp/avr-gcc-wasm": "^0.2.0",
    "@salusoft89/planegcs": "^1.1.7",
    "@tailwindcss/vite": "^4.0.9",
    "@vitekk02/cadjs": "file:vendor/cadjs",
    "avr8js": "^0.21.1",
    "opencascade.js": "2.0.0-beta.b5ff984",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rp2040js": "^1.4.1",
    "stm32f4-emu": "^1.7.0",
    "tailwindcss": "^4.0.9",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "file-loader": "^6.2.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^5.0.5"
  }
}
