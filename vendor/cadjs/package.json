{
  "name": "@vitekk02/cadjs",
  "version": "0.1.1",
  "description": "Web CAD library: BRep geometry, OpenCascade.js operations, sketch solver, and React bindings.",
  "type": "module",
  "license": "MIT",
  "author": "Vitek Hnatovskyj <vitek.hnatovskyj@seznam.cz>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitekk02/cadjs.git"
  },
  "homepage": "https://github.com/vitekk02/cadjs#readme",
  "bugs": {
    "url": "https://github.com/vitekk02/cadjs/issues"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cad",
    "brep",
    "opencascade",
    "geometry",
    "three.js",
    "wasm",
    "sketch",
    "constraints"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:check": "api-extractor run --config api-extractor.json && api-extractor run --config api-extractor.react.json",
    "api:update": "api-extractor run --local --config api-extractor.json && api-extractor run --local --config api-extractor.react.json",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run api:check"
  },
  "dependencies": {
    "@salusoft89/planegcs": "^1.1.7",
    "fflate": "^0.8.3",
    "opencascade.js": "2.0.0-beta.b5ff984"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "three": ">=0.174.0 <1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  }
}
